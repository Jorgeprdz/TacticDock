<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- Frosted surface: diffuse wallpaper texture without hiding it entirely. -->
    <corners android:radius="18dp"/>
    <gradient android:angle="270"
        android:startColor="#EAF8F9FD"
        android:centerColor="#E3F1F4FA"
        android:endColor="#DCE9EDF5"/>
    <stroke android:width="0.7dp" android:color="#EFFFFFFF"/>
</shape>
