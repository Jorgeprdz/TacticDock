<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- Frosted surface: diffuse wallpaper texture without hiding it entirely. -->
    <corners android:radius="20dp"/>
    <gradient android:angle="270"
        android:startColor="#D1D5DCE4"
        android:centerColor="#C7CBD4DF"
        android:endColor="#B8BEC9D6"/>
    <stroke android:width="0.7dp" android:color="#DFFFFFFF"/>
</shape>
