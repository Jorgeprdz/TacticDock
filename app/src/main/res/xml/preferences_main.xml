<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- Only controls used by the DeX-only Tactic Dock experience. -->
    <PreferenceCategory android:title="@string/tactic_settings_personalization">
        <cu.axel.smartdock.preferences.PreferenceHeader
            android:icon="@drawable/ic_dock"
            android:title="@string/tactic_settings_dock"
            app:fragment="cu.axel.smartdock.fragments.DockPreferences" />
        <cu.axel.smartdock.preferences.PreferenceHeader
            android:icon="@drawable/ic_appearance"
            android:title="@string/tactic_settings_appearance"
            app:fragment="cu.axel.smartdock.fragments.AppearancePreferences" />
        <cu.axel.smartdock.preferences.PreferenceHeader
            android:icon="@drawable/ic_apps_menu"
            android:title="@string/tactic_settings_apps"
            app:fragment="cu.axel.smartdock.fragments.AppMenuPreferences" />
        <cu.axel.smartdock.preferences.PreferenceHeader
            android:icon="@drawable/ic_notifications"
            android:title="@string/tactic_settings_notifications"
            app:fragment="cu.axel.smartdock.fragments.NotificationPreferences" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/tactic_settings_support">
        <cu.axel.smartdock.preferences.PreferenceHeader
            android:icon="@drawable/ic_advanced"
            android:title="@string/tactic_settings_diagnostics"
            app:fragment="cu.axel.smartdock.fragments.AdvancedPreferences" />
        <cu.axel.smartdock.preferences.PreferenceHeader
            android:icon="@drawable/ic_info"
            android:title="@string/tactic_settings_about"
            app:fragment="cu.axel.smartdock.fragments.HelpAboutPreferences" />
    </PreferenceCategory>
</PreferenceScreen>
