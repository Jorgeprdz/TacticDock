<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <Preference
        android:icon="@mipmap/ic_launcher_round"
        android:title="@string/app_name"
        android:summary="@string/tactic_about_summary" />
    <Preference
        android:title="@string/tactic_project"
        android:summary="github.com/Jorgeprdz/TacticDock">
        <intent android:action="android.intent.action.VIEW"
            android:data="https://github.com/Jorgeprdz/TacticDock" />
    </Preference>
    <Preference
        android:title="@string/tactic_original_credits"
        android:summary="@string/tactic_original_summary">
        <intent android:action="android.intent.action.VIEW"
            android:data="https://github.com/axel358/smartdock" />
    </Preference>
    <Preference
        android:title="@string/license"
        android:summary="@string/gnu_general_public_licence_v3" />
</PreferenceScreen>
