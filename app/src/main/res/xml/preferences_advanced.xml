<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No root, secure-setting mutation, status-bar alterations, heads-up override,
         soft reboot or Android-x86 development preferences. -->
    <PreferenceCategory android:title="@string/tactic_settings_diagnostics">
        <Preference
            android:key="share_display_info"
            android:title="@string/tactic_display_info"
            android:summary="@string/tactic_display_info_summary" />
        <Preference
            android:key="backup_preferences"
            android:title="@string/tactic_export_config" />
        <Preference
            android:key="restore_preferences"
            android:title="@string/tactic_import_config" />
    </PreferenceCategory>
</PreferenceScreen>
