<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/tactic_settings_apps">
        <cu.axel.smartdock.preferences.FileChooserPreference
            android:key="menu_icon_uri"
            android:defaultValue="default"
            android:title="@string/tactic_launcher_icon" />
        <EditTextPreference
            android:key="num_columns"
            android:defaultValue="5"
            android:title="@string/tactic_launcher_columns" />
        <ListPreference
            android:key="launch_mode"
            android:defaultValue="standard"
            android:entries="@array/launch_modes"
            android:entryValues="@array/launch_mode_values"
            android:title="@string/tactic_launch_mode" />
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/tactic_app_visibility">
        <SwitchPreferenceCompat
            android:key="enable_app_hiding_grid"
            android:defaultValue="false"
            android:title="@string/tactic_enable_hiding" />
        <cu.axel.smartdock.preferences.AppChooserMultiplePreference
            android:key="hidden_apps_grid"
            android:dependency="enable_app_hiding_grid"
            android:title="@string/tactic_hidden_apps" />
    </PreferenceCategory>
</PreferenceScreen>
