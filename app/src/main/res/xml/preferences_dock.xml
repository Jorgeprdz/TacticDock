<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Dock is permanently pinned; activation gestures/handles and portrait mode
         belong to the old phone-oriented SmartDock product, not Samsung DeX. -->
    <PreferenceCategory android:title="@string/tactic_settings_dock">
        <EditTextPreference
            android:key="max_running_apps_landscape"
            android:defaultValue="10"
            android:title="@string/tactic_max_apps"
            android:summary="@string/tactic_max_apps_summary" />
        <cu.axel.smartdock.preferences.IconPackPreference
            android:key="icon_pack"
            android:title="@string/tactic_icon_pack" />
    </PreferenceCategory>
</PreferenceScreen>
