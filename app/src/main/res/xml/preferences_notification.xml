<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/tactic_settings_notifications">
        <SwitchPreferenceCompat
            android:key="show_notifications"
            android:defaultValue="true"
            android:title="@string/tactic_external_popups"
            android:summary="@string/tactic_external_popups_summary" />
        <EditTextPreference
            android:key="notification_display_time"
            android:dependency="show_notifications"
            android:defaultValue="5"
            android:title="@string/tactic_popup_duration" />
        <cu.axel.smartdock.preferences.AppChooserMultiplePreference
            android:key="ignored_notifications_popups"
            android:dependency="show_notifications"
            android:title="@string/tactic_popup_ignored_apps" />
        <SwitchPreferenceCompat
            android:key="enable_notif_panel"
            android:defaultValue="true"
            android:title="@string/tactic_notifications_panel" />
        <Preference android:title="@string/tactic_notification_access">
            <intent android:action="android.settings.ACTION_NOTIFICATION_LISTENER_SETTINGS" />
        </Preference>
    </PreferenceCategory>
</PreferenceScreen>
